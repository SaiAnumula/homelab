# Copy this file to .env and replace every placeholder.
# Never commit the real .env file.

# Pin a release and upgrade on purpose after reading the release notes.
IMMICH_VERSION=v3.3.3

# The server's Tailscale IPv4 address, from `tailscale ip -4`.
TAILSCALE_IP=100.64.0.1
DB_USERNAME=postgres
DB_PASSWORD=generate-a-long-random-password
DB_DATABASE=immich
